{
  "name": "ViP+TV",
  "short_name": "ViP+TV",
  "description": "ViP+TV Live TV Web App",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#03070b",
  "theme_color": "#03070b",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "vip-tv-logo-512.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "vip-tv-logo-512.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "vip-tv-logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}